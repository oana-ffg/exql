{
  "name": "exql",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "dotnet run --project devhost",
    "build": "tsc -b && vite build",
    "icon": "node scripts/generate-icon.mjs",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run build && npm test && dotnet restore server.tests --configfile NuGet.Config && dotnet test server.tests --no-restore && dotnet restore desktop --configfile NuGet.Config && dotnet build desktop --no-restore",
    "start": "dotnet run --project desktop",
    "format": "prettier --write src tests shared scripts/*.mjs scripts/ci/*.mjs .github *.json *.ts *.md",
    "format:check": "prettier --check src tests shared scripts/*.mjs scripts/ci/*.mjs .github *.json *.ts *.md",
    "test:desktop": "powershell.exe -NoProfile -File scripts/test-desktop.ps1"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "lucide-react": "^1.42.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "agent-browser": "^0.27.0",
    "mssql": "^12.7.13",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  }
}
